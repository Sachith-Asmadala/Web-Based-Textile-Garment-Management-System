# TGMS production environment contract (example values only).
# Store real values in the deployment platform's secret/environment manager.
# Do NOT copy this file with real secrets into Git.

PORT=3000
CLIENT_ORIGIN=https://tgms.example.com

DB_URL=jdbc:mysql://mysql.example.internal:3306/tgms?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=true
DB_USERNAME=tgms_app
DB_PASSWORD=REPLACE_IN_SECRET_MANAGER
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_ALLOW_ROLLBACK=false

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_SESSION_HOURS=8
COOKIE_SECURE=true

PASSWORD_RESET_TTL_MINUTES=30
SMTP_ENABLED=true
MAIL_FROM=no-reply@tgms.example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_IN_SECRET_MANAGER
SMTP_PASSWORD=REPLACE_IN_SECRET_MANAGER
SMTP_AUTH=true
SMTP_USE_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

NOTIFICATIONS_ENABLED=true
