{
  "name": "textile-garment-management-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors blue,magenta \"npm run dev:backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "cd backend && ./mvnw spring-boot:run",
    "build": "npm run build --workspace frontend && npm run build:backend",
    "build:backend": "cd backend && ./mvnw package -DskipTests",
    "test": "npm run test --workspace frontend && npm run test:backend",
    "test:backend": "cd backend && ./mvnw test",
    "db:status": "dotenv -e backend/.env -- node scripts/run-liquibase.mjs status",
    "db:migrate": "dotenv -e backend/.env -- node scripts/run-liquibase.mjs update",
    "db:rollback:preview": "dotenv -e backend/.env -- node scripts/run-liquibase.mjs rollback-preview",
    "db:rollback": "dotenv -e backend/.env -- node scripts/run-liquibase.mjs rollback",
    "db:verify": "cd backend && ./mvnw -Dtest=DatabaseMigrationTests test",
    "typecheck": "npm run typecheck --workspace frontend && npm run compile:backend",
    "compile:backend": "cd backend && ./mvnw compile",
    "lint": "npm run lint --workspace frontend && eslint scripts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
